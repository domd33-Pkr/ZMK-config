#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEGREE RA(LS(SEMI))

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp &kp>;
        };

        ht_delta_deg: ht_delta_deg {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_delta &deg>;
        };

        ht_deg_delta: ht_deg_delta {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&deg &uc_delta>;
        };

        ht_pi_ohm: ht_pi_ohm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_pi &uc_ohm>;
        };

        ht_ohm_pi: ht_ohm_pi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_ohm &uc_pi>;
        };

        mtl: mo_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo &sl>;
        };

        sk: sticky_key {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
        };

        sl: sticky_layer {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1000>;
        };
    };

    macros {
        deg: deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DEGREE>;
        };

        single_tilde: single_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(GRAVE) &kp SPACE>;
        };

        uc_delta: uc_delta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp NUMBER_9 &kp NUMBER_4 &kp RET>;
        };

        uc_pi: uc_pi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp C &kp NUMBER_0 &kp RET>;
        };

        uc_ohm: uc_ohm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp A &kp NUMBER_9 &kp RET>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 5                      // 1
                &sl 2                      // 2
                &none                      // 3
                &ht LS(R) R                // 4
                &ht LS(L) L                // 5
                &ht LS(T) T                // 6
                &ht LS(B) B                // 7
                &ht LS(N) N                // 8
                &ht LS(M) M                // 9
                &sl 1                      // 10

                // Right hand (Index 11 to 20)
                &kp SPC                    // 11
                &ht LS(E) E                // 12
                &none                      // 13
                &ht LS(C) C                // 14
                &ht LS(U) U                // 15
                &ht LS(S) S                // 16
                &ht LS(O) O                // 17
                &ht LS(D) D                // 18
                &ht LS(I) I                // 19
                &ht LS(A) A                // 20
            >;
        };

        layer_2 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &sl 2                      // 2
                &none                      // 3
                &ht LS(Z) Z                // 4
                &ht LS(Q) Q                // 5
                &ht LS(X) X                // 6
                &ht LS(K) K                // 7
                &ht LS(W) W                // 8
                &caps_word                 // 9
                &sl 4                      // 10

                // Right hand (Index 11 to 20)
                &kp BSPC                   // 11
                &kp DEL                    // 12
                &none                      // 13
                &ht LS(P) P                // 14
                &ht LS(F) F                // 15
                &ht LS(H) H                // 16
                &ht LS(J) J                // 17
                &ht LS(G) G                // 18
                &ht LS(Y) Y                // 19
                &ht LS(V) V                // 20
            >;
        };

        layer_3 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 3                      // 1
                &trans                     // 2
                &none                      // 3
                &kp EQUAL                  // 4
                &kp NUMBER_0               // 5
                &kp LS(EQUAL)              // 6
                &kp MINUS                  // 7
                &kp LS(NUMBER_8)           // 8
                &kp BSLH                   // 9
                &sl 0                      // 10

                // Right hand (Index 11 to 20)
                &kp NUMBER_1               // 11
                &kp NUMBER_2               // 12
                &none                      // 13
                &kp NUMBER_3               // 14
                &kp NUMBER_4               // 15
                &kp NUMBER_5               // 16
                &kp NUMBER_6               // 17
                &kp NUMBER_7               // 18
                &kp NUMBER_8               // 19
                &kp NUMBER_9               // 20
            >;
        };

        layer_4 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &mo 2                      // 2
                &none                      // 3
                &kp RET                    // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &kp CARET                  // 8
                &trans                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp LS(A)                  // 11
                &kp LS(B)                  // 12
                &none                      // 13
                &kp LS(C)                  // 14
                &kp LS(D)                  // 15
                &kp LS(E)                  // 16
                &kp LS(F)                  // 17
                &ht_delta_deg 0 0          // 18
                &ht_pi_ohm 0 0             // 19
                &trans                     // 20
            >;
        };

        layer_5 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &none                      // 2
                &none                      // 3
                &ht BSLH FSLH              // 4
                &none                      // 5
                &ht LS(BSLH) LS(NUMBER_7)  // 6
                &none                      // 7
                &trans                     // 8
                &trans                     // 9
                &mo 4                      // 10

                // Right hand (Index 11 to 20)
                &ht DOT COMMA              // 11
                &ht LS(NUMBER_0) LS(NUMBER_9)// 12
                &none                      // 13
                &ht LS(SQT) SQT            // 14
                &ht LS(RBKT) LS(LBKT)      // 15
                &ht LS(SEMI) SEMI          // 16
                &ht RBKT LBKT              // 17
                &ht LS(FSLH) LS(NUMBER_1)  // 18
                &ht LS(DOT) LS(COMMA)      // 19
                &none                      // 20
            >;
        };

        layer_6 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 5                      // 1
                &mo 6                      // 2
                &none                      // 3
                &kp LALT                   // 4
                &kp RALT                   // 5
                &kp LSHIFT                 // 6
                &kp LGUI                   // 7
                &kp LCTRL                  // 8
                &trans                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp BSPC                   // 11
                &kp DEL                    // 12
                &none                      // 13
                &ht LS(NUMBER_4) LS(NUMBER_5)// 14
                &kp TAB                    // 15
                &ht LS(GRAVE) LS(NUMBER_3) // 16
                &kp RET                    // 17
                &trans                     // 18
                &trans                     // 19
                &kp ESC                    // 20
            >;
        };

        layer_7 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 6                      // 1
                &trans                     // 2
                &none                      // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp LC(Z)                  // 11
                &kp LC(S)                  // 12
                &none                      // 13
                &kp LC(V)                  // 14
                &kp LC(A)                  // 15
                &kp LC(C)                  // 16
                &kp LC(F)                  // 17
                &kp LC(X)                  // 18
                &kp LC(H)                  // 19
                &kp LC(Y)                  // 20
            >;
        };

        layer_8 {
            bindings = <
                // Left hand (Index 1 to 10)
                &sl 2                      // 1
                &sl 1                      // 2
                &none                      // 3
                &kp LALT                   // 4
                &kp RALT                   // 5
                &kp LSHIFT                 // 6
                &kp LGUI                   // 7
                &kp LCTRL                  // 8
                &trans                     // 9
                &mo 5                      // 10

                // Right hand (Index 11 to 20)
                &kp LEFT                   // 11
                &kp RIGHT                  // 12
                &none                      // 13
                &kp UP                     // 14
                &kp DOWN                   // 15
                &kp PG_UP                  // 16
                &kp PG_DN                  // 17
                &trans                     // 18
                &kp HOME                   // 19
                &kp END                    // 20
            >;
        };

        layer_9 {
            bindings = <
                // Left hand (Index 1 to 10)
                &ht_pi_ohm 0 0             // 1
                &ht_delta_deg 0 0          // 2
                &mo 8                      // 3
                &kp FSLH                   // 4
                &kp BSLH                   // 5
                &kp LS(BSLH)               // 6
                &kp LS(NUMBER_7)           // 7
                &trans                     // 8
                &kp LS(NUMBER_2)           // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &ht SEMI LS(SEMI)          // 11
                &ht DOT COMMA              // 12
                &ht MINUS SQT              // 13
                &ht LS(DLLR) LS(PRCNT)     // 14
                &ht LS(NUMBER_0) LS(NUMBER_9)// 15
                &ht LS(GRAVE) HASH         // 16
                &ht LS(RBKT) LS(LBKT)      // 17
                &ht LS(NUMBER_1) LS(FSLH)  // 18
                &ht RBKT LBKT              // 19
                &ht LS(DOT) LS(COMMA)      // 20
            >;
        };

        layer_10 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_11 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_12 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_13 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_14 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_15 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_16 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

    };
};
