#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>

#define DEGREE RA(LS(SEMI))

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp &kp>;
        };

        ht_delta_deg: ht_delta_deg {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_delta &deg>;
        };

        ht_deg_delta: ht_deg_delta {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&deg &uc_delta>;
        };

        ht_pi_ohm: ht_pi_ohm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_pi &uc_ohm>;
        };

        ht_ohm_pi: ht_ohm_pi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc_ohm &uc_pi>;
        };

        mm_agrave: mod_morph_agrave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_agrave>, <&macro_agrave_maj>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_egrave: mod_morph_egrave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_egrave>, <&macro_egrave_maj>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_ccedilla: mod_morph_ccedilla {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_ccedilla>, <&macro_ccedilla_maj>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mtl: mo_tap_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo &sl>;
        };

        sk: sticky_key {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
        };

        sl: sticky_layer {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <1000>;
        };
    };

    macros {
        deg: deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DEGREE>;
        };

        single_tilde: single_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(GRAVE) &kp SPACE>;
        };

        macro_agrave: macro_agrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp A>;
        };

        macro_agrave_maj: macro_agrave_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp LS(A)>;
        };

        macro_egrave: macro_egrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp E>;
        };

        macro_egrave_maj: macro_egrave_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp SQT &kp LS(E)>;
        };

        macro_ccedilla: macro_ccedilla {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp RBKT &kp C>;
        };

        macro_ccedilla_maj: macro_ccedilla_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp RBKT &kp LS(C)>;
        };

        uc_delta: uc_delta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp NUMBER_9 &kp NUMBER_4 &kp RET>;
        };

        uc_pi: uc_pi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp C &kp NUMBER_0 &kp RET>;
        };

        uc_ohm: uc_ohm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <1>;
            wait-ms = <1>;
            bindings = <&macro_press &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp U>
                     , <&macro_release &kp LCTRL &kp LSHFT>
                     , <&macro_tap &kp NUMBER_0 &kp NUMBER_3 &kp A &kp NUMBER_9 &kp RET>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
                // Left hand (Index 1 to 10)
                &sl 5                      // 1
                &sl 9                      // 2
                &none                      // 3
                &ht LS(R) R                // 4
                &ht LS(L) L                // 5
                &ht LS(T) T                // 6
                &ht LS(B) B                // 7
                &ht LS(N) N                // 8
                &ht LS(M) M                // 9
                &sl 1                      // 10

                // Right hand (Index 11 to 20)
                &kp SPC                    // 11
                &ht LS(E) E                // 12
                &none                      // 13
                &ht LS(C) C                // 14
                &ht LS(U) U                // 15
                &ht LS(S) S                // 16
                &ht LS(O) O                // 17
                &ht LS(D) D                // 18
                &ht LS(I) I                // 19
                &ht LS(A) A                // 20
            >;
        };

        layer_2 {
            bindings = <
                // Left hand (Index 1 to 10)
                &sl 2                      // 1
                &sl 4                      // 2
                &none                      // 3
                &ht LS(Z) Z                // 4
                &ht LS(Q) Q                // 5
                &ht LS(X) X                // 6
                &ht LS(K) K                // 7
                &ht LS(W) W                // 8
                &caps_word                 // 9
                &mo 1                      // 10

                // Right hand (Index 11 to 20)
                &kp BSPC                   // 11
                &kp DEL                    // 12
                &none                      // 13
                &ht LS(P) P                // 14
                &ht LS(F) F                // 15
                &ht LS(H) H                // 16
                &ht LS(J) J                // 17
                &ht LS(G) G                // 18
                &ht LS(Y) Y                // 19
                &ht LS(V) V                // 20
            >;
        };

        layer_3 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 2                      // 1
                &mo 3                      // 2
                &none                      // 3
                &kp NUMBER_0               // 4
                &kp DOT                    // 5
                &kp LS(EQUAL)              // 6
                &kp MINUS                  // 7
                &kp LS(NUMBER_8)           // 8
                &kp LS(NUMBER_3)           // 9
                &sl 9                      // 10

                // Right hand (Index 11 to 20)
                &kp NUMBER_1               // 11
                &kp NUMBER_2               // 12
                &none                      // 13
                &kp NUMBER_3               // 14
                &kp NUMBER_4               // 15
                &kp NUMBER_5               // 16
                &kp NUMBER_6               // 17
                &kp NUMBER_7               // 18
                &kp NUMBER_8               // 19
                &kp NUMBER_9               // 20
            >;
        };

        layer_4 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 2                      // 1
                &mo 3                      // 2
                &none                      // 3
                &kp RET                    // 4
                &kp DEGREE                 // 5
                &uc_delta                  // 6
                &uc_ohm                    // 7
                &kp CARET                  // 8
                &uc_pi                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp LS(A)                  // 11
                &kp LS(B)                  // 12
                &none                      // 13
                &kp LS(C)                  // 14
                &kp LS(D)                  // 15
                &kp LS(E)                  // 16
                &kp LS(F)                  // 17
                &kp LS(NUMBER_7)           // 18
                &single_tilde              // 19
                &kp RA(GRAVE)              // 20
            >;
        };

        layer_5 {
            bindings = <
                // Left hand (Index 1 to 10)
                &none                      // 1
                &mo 4                      // 2
                &none                      // 3
                &none                      // 4
                &none                      // 5
                &none                      // 6
                &none                      // 7
                &none                      // 8
                &none                      // 9
                &none                      // 10

                // Right hand (Index 11 to 20)
                &kp LS(NUMBER_9)           // 11
                &kp LS(NUMBER_0)           // 12
                &none                      // 13
                &kp RA(SQT)                // 14
                &kp RA(BSLH)               // 15
                &kp RA(LBKT)               // 16
                &kp RA(RBKT)               // 17
                &kp BSLH                   // 18
                &kp LS(BSLH)               // 19
                &kp LS(SQT)                // 20
            >;
        };

        layer_6 {
            bindings = <
                // Left hand (Index 1 to 10)
                &mo 5                      // 1
                &sl 6                      // 2
                &none                      // 3
                &kp LALT                   // 4
                &kp RALT                   // 5
                &kp LSHIFT                 // 6
                &kp LGUI                   // 7
                &kp LCTRL                  // 8
                &trans                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp BSPC                   // 11
                &kp FSLH                   // 12
                &none                      // 13
                &mm_egrave                 // 14
                &mm_agrave                 // 15
                &kp LS(NUMBER_4)           // 16
                &kp RA(SEMI)               // 17
                &mm_ccedilla               // 18
                &none                      // 19
                &kp RET                    // 20
            >;
        };

        layer_7 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &mo 6                      // 2
                &none                      // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &kp LC(Z)                  // 11
                &kp LC(S)                  // 12
                &none                      // 13
                &kp LC(C)                  // 14
                &kp LC(A)                  // 15
                &kp LC(V)                  // 16
                &kp LC(F)                  // 17
                &kp LC(X)                  // 18
                &kp LC(H)                  // 19
                &kp LC(Y)                  // 20
            >;
        };

        layer_8 {
            bindings = <
                // Left hand (Index 1 to 10)
                &sl 5                      // 1
                &sl 9                      // 2
                &none                      // 3
                &kp LALT                   // 4
                &kp RALT                   // 5
                &kp LSHIFT                 // 6
                &kp LGUI                   // 7
                &kp LCTRL                  // 8
                &mo 6                      // 9
                &mo 5                      // 10

                // Right hand (Index 11 to 20)
                &kp LEFT                   // 11
                &kp RIGHT                  // 12
                &none                      // 13
                &kp UP                     // 14
                &kp DOWN                   // 15
                &kp PG_UP                  // 16
                &kp PG_DN                  // 17
                &trans                     // 18
                &kp HOME                   // 19
                &kp END                    // 20
            >;
        };

        layer_9 {
            bindings = <
                // Left hand (Index 1 to 10)
                &ht_pi_ohm 0 0             // 1
                &ht_delta_deg 0 0          // 2
                &none                      // 3
                &kp FSLH                   // 4
                &kp BSLH                   // 5
                &kp LS(BSLH)               // 6
                &kp LS(NUMBER_7)           // 7
                &trans                     // 8
                &kp LS(NUMBER_2)           // 9
                &mo 7                      // 10

                // Right hand (Index 11 to 20)
                &ht SEMI LS(SEMI)          // 11
                &ht DOT COMMA              // 12
                &none                      // 13
                &mm_egrave                 // 14
                &mm_agrave                 // 15
                &kp LS(NUMBER_4)           // 16
                &single_tilde              // 17
                &kp FSLH                   // 18
                &mm_ccedilla               // 19
                &ht LS(DOT) LS(COMMA)      // 20
            >;
        };

        layer_10 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &mo 9                      // 2
                &none                      // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &mo 10                     // 10

                // Right hand (Index 11 to 20)
                &kp COMMA                  // 11
                &kp DOT                    // 12
                &none                      // 13
                &kp LS(COMMA)              // 14
                &kp MINUS                  // 15
                &kp SEMI                   // 16
                &kp LS(SEMI)               // 17
                &kp LS(NUMBER_1)           // 18
                &kp LS(NUMBER_6)           // 19
                &kp TAB                    // 20
            >;
        };

        layer_11 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_12 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_13 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_14 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_15 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

        layer_16 {
            bindings = <
                // Left hand (Index 1 to 10)
                &trans                     // 1
                &trans                     // 2
                &trans                     // 3
                &trans                     // 4
                &trans                     // 5
                &trans                     // 6
                &trans                     // 7
                &trans                     // 8
                &trans                     // 9
                &trans                     // 10

                // Right hand (Index 11 to 20)
                &trans                     // 11
                &trans                     // 12
                &trans                     // 13
                &trans                     // 14
                &trans                     // 15
                &trans                     // 16
                &trans                     // 17
                &trans                     // 18
                &trans                     // 19
                &trans                     // 20
            >;
        };

    };
};
